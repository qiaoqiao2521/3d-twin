{
  "name": "mega-hangar-digital-twin-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "automotive:build": "node scripts/build-automotive.mjs",
    "predev": "npm run automotive:build && npm run build:warehouse && npm run build:open-demos && npm run build:hardware",
    "dev": "vite --port=5197 --host=0.0.0.0",
    "prebuild": "npm run automotive:build && npm run build:warehouse && npm run build:open-demos && npm run build:hardware",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "test": "bun test",
    "remaster:assets": "node scripts/remaster_glb_assets.mjs",
    "preview": "vite preview",
    "postinstall": "npm run install:warehouse && npm run install:open-demos",
    "install:warehouse": "npm ci --prefix integrations/smart-warehouse/upstream --no-audit --no-fund",
    "build:warehouse": "node scripts/build-smart-warehouse.mjs",
    "verify:warehouse": "node scripts/verify-smart-warehouse.mjs",
    "test:warehouse": "node --test src/utils/workspaceRoutes.test.ts src/utils/ironBridge.test.ts src/shared/inspection/sceneInspection.test.ts integrations/smart-warehouse/lifecycle.test.ts research/smart-warehouse/agvStudy.test.ts",
    "study:warehouse": "node scripts/study-warehouse-agv.mjs",
    "install:open-demos": "node scripts/open-demos.mjs install",
    "build:open-demos": "node scripts/open-demos.mjs build",
    "verify:open-demos": "node scripts/verify-open-demos.mjs",
    "test:open-demos": "node --test src/utils/workspaceRoutes.test.ts integrations/open-demos/host.test.mjs",
    "install:demo-backends": "node scripts/start-open-demo.mjs waretwin --setup-only && node scripts/start-open-demo.mjs rftwin --setup-only",
    "start:waretwin": "node scripts/start-open-demo.mjs waretwin",
    "start:rftwin": "node scripts/start-open-demo.mjs rftwin",
    "verify:demo-backends": "node scripts/verify-open-demo-backends.mjs",
    "install:hardware": "node scripts/hardware/toolchain.mjs",
    "build:hardware": "node scripts/build-hardware.mjs",
    "verify:hardware": "node scripts/verify-hardware.mjs",
    "test:hardware": "node --test src/utils/hardware.test.ts src/utils/hardwareDraco.test.ts src/utils/workspaceRoutes.test.ts integrations/hardware/host.test.mjs integrations/hardware/devices/test_lifecycle.mjs integrations/hardware/robots/source-cache.test.mjs",
    "verify:robotics": "node scripts/verify-robotics.mjs",
    "test:motoman-weld": "python3 -m unittest discover -s integrations/hardware/robots -p test_motoman_weld.py -v",
    "test:hardware:cad": "node scripts/test-hardware-cad.mjs",
    "verify:hardware:kinematics": "node scripts/verify-hardware-kinematics.mjs",
    "test:hardware:opcua": "python3 -m unittest discover -s research/hardware/opcua -p 'test_*.py' -v"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "meshoptimizer": "^1.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "three-gpu-pathtracer": "^0.0.23",
    "three-mesh-bvh": "^0.9.18",
    "urdf-loader": "0.13.1"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.6.2",
    "draco3dgltf": "^1.5.9",
    "linkedom": "0.18.12",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.2",
    "vite": "^5.4.10"
  }
}
